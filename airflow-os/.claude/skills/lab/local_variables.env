# 로컬 파싱/테스트용 더미 Airflow Variables/Connections. verify.sh가 자동으로 로드한다.
# 작업하는 DAG가 파싱 시점에 조회하는 값만 그때그때 추가한다. 실제 운영 값은 절대 넣지 않는다.
#
# 형식:
#   Variable:            export AIRFLOW_VAR_<KEY>="dummy"
#   Variable(JSON형):    export AIRFLOW_VAR_<KEY>='{"k": "v"}'   # 코드가 참조하는 키 구조까지 맞출 것
#   Connection:          export AIRFLOW_CONN_<ID>="mysql://dummy:dummy@localhost:3306/dummy"

# doris fastlog 적재 DAG (fastlog_config 가 파싱 시점에 조회)
export AIRFLOW_VAR_SEAWEED_ACCESS_KEY="dummy"
export AIRFLOW_VAR_SEAWEED_SECRET_KEY="dummy"
