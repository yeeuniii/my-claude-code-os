{
  "permissions": {
    "additionalDirectories": [
      "/Users/yepark/Project/airflow.datawave.co.kr"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^dag-(reviewer|builder|tester)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-injection.sh --hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/os-reminder.sh"
          }
        ]
      }
    ]
  }
}
